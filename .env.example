# Supabase project configuration (client-side, build-time).
# These are PUBLIC values — the anon key is safe to expose because access is
# enforced server-side by Row Level Security. Never put a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: comma-separated list of origins allowed to call the OAuth edge
# functions. Configure this as a Supabase Function secret (not a VITE_ var).
# ALLOWED_ORIGINS=https://yourdomain.org,https://www.yourdomain.org
